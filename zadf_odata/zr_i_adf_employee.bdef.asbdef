managed implementation in class zbp_r_i_adf_employee unique;
strict ( 2 );

define behavior for ZR_I_ADF_EMPLOYEE alias ADF_EMPLOYEE
persistent table /dmo/employee_hr
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) Employee;

  mapping for /dmo/employee_hr {

    Employee = employee;
    FirstName = first_name;
    LastName = last_name;
    Salary = salary;
    SalaryCurrency = salary_currency;
    Manager = manager;

  }
}